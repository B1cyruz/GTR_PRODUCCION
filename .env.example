# Configuración del Entorno - GTR Logistics
PROJECT_NAME="GTR - Gestión Logística y Rutas"
ENVIRONMENT="production"
DEBUG=False
SECRET_KEY="gtr_production_secret_key_change_me_in_prod_2026"

# Base de datos PostgreSQL exclusiva
POSTGRES_USER=gtr_user
POSTGRES_PASSWORD=gtr_secure_password_2026
POSTGRES_DB=gtr_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gtr_user:gtr_secure_password_2026@postgres:5432/gtr_db

# Configuración de Servidor
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Configuración de Ciudad y Mapa (Cartagena, Colombia por defecto)
DEFAULT_CITY="Cartagena"
DEFAULT_LAT=10.3997
DEFAULT_LNG=-75.5144
DEFAULT_ZOOM=13
